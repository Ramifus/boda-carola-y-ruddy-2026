---
// Confirmar.astro
---

<section id="confirmar" class="relative w-full py-10 px-6 text-center overflow-hidden isolate">

    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 right-0 w-40 pointer-events-none select-none opacity-30 -translate-y-1/2 scale-x-[-1] z-[-1]"
    />
    <!-- SEPARADOR -->
    <img
        data-revelar="centro"
        src="/imagenes/separador.png"
        alt=""
        aria-hidden="true"
        class="mx-auto mb-7 w-48"
    />

    <!-- TÍTULO -->
    <p data-revelar="arriba" class="font-above text-[1.51rem] text-[#4A1418] leading-snug">
        Confirmar Asistencia
    </p>

    <!-- TEXTO -->
    <p
        data-revelar="izquierda"
        class="font-cormorant italic text-xl text-[#6B7133] mt-4 leading-relaxed max-w-xs mx-auto"
    >
        Tu presencia es muy importante para nosotros. <br />
        <span class="font-semibold" style="color: #4A1418;"
            >Por favor, confírmanos tu asistencia.
            </span
        >
    </p>

    <!-- BOTÓN WHATSAPP -->
    <div data-revelar="derecha" class="flex flex-col items-center gap-4 mt-8">
        <a
            href="https://wa.me/59164565135?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Carola%20%26%20Ruddy%2C%20que%20se%20realizar%C3%A1%20el%20s%C3%A1bado%207%20de%20noviembre.%20%C2%A1Estar%C3%A9%20sin%20falta!%20Muchas%20gracias%20%E2%9D%A4%EF%B8%8F"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full max-w-xs block py-3 px-6 rounded-full font-cormorant uppercase text-sm tracking-widest text-white bg-[#4A1418] hover:opacity-85 transition-opacity"
        >
            Confirmar por WhatsApp
        </a>
    </div>

    
</section>
